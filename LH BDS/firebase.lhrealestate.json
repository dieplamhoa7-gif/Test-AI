{
  "hosting": {
    "site": "lhrealestate",
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**",
        "headers": [
          {"key": "Cache-Control", "value": "no-store, max-age=0"}
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "lhrealestate-api"
    }
  ]
}
